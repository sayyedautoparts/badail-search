# انسخ هذا الملف إلى: scripts/daily_upload.local.env
# ثم ضع رابط Neon من Vercel (Environment Variables)

NEON_DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# المجلد الأب لملفات الإكسل على الجهاز
BADAIL_EXCEL_BASE=G:\ملفاتي

# أسماء أجهزة/مستخدمين مسموح لها بالرفع التلقائي (فاصلة)
# مثال لجهاز Asim: Asim,sayyed
# اتركه فارغاً للسماح لأي جهاز عليه هذا السكربت
BADAIL_UPLOAD_HOSTS=Asim,sayyed
